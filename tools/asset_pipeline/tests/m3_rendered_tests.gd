extends "res://tools/asset_pipeline/tests/m2_rendered_tests.gd"

func aim_at(player: Node3D, station: Node) -> void:
	player.global_position = Vector3(station.proxy.global_position.x,0.0,station.proxy.global_position.z+1.7)
	await frames(3)
	player.camera.look_at(station.proxy.global_position)
	player._pitch = player.camera.rotation.x
	await frames(3)
	check(station.is_targeted(), "ordinary reach/obstruction targeting: " + station.destination)

func take_seed(wing: Node, id: String) -> ItemInstance:
	var host = wing.get_node("DevelopmentSetup/SeedItems").get_children().filter(func(h): return String(h.item_id)==id and h.has_node("WorldItem") and h.get_node("WorldItem").get_item_instance()!=null)[0]
	var item: ItemInstance = host.get_node("WorldItem").get_item_instance()
	check(host.get_node("WorldItem").pickup_into(wing.get_node("Player/CarriedItems")),"real seed TAKE " + id)
	wing.get_node("Player/CarriedItems").select_index(wing.get_node("Player/CarriedItems").get_slots().find(item))
	return item

func run() -> void:
	create_timer(120).timeout.connect(func():
		push_error("M3 rendered helper aborted; completion missing")
		quit(3))
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--m3-evidence-dir="): evidence_dir = arg.trim_prefix("--m3-evidence-dir=")
	if not check(evidence_dir.is_absolute_path() and not evidence_dir.begins_with(ProjectSettings.globalize_path("res://")),"external rendered and save destination required"):
		finish()
		return
	DirAccess.make_dir_recursive_absolute(evidence_dir)
	print("M3_RENDERER ",RenderingServer.get_current_rendering_method()," display=",DisplayServer.get_name())
	var shell = load("res://gameplay/run/run_shell.tscn").instantiate()
	shell.save_service = load("res://gameplay/run/run_save_service.gd").new(evidence_dir.path_join("slot"))
	root.add_child(shell)
	if not check(shell.start_new_run(),"rendered M3 uses injected production save service"):
		shell.free()
		finish()
		return
	var wing = shell.wing
	wing.set_process(false)
	var player = wing.get_node("Player")
	player.set_physics_process(false)
	wing.run_schedule.advance(300.0)
	var kitchen = wing.get_node("KitchenContribution")
	var medical = wing.get_node("MedicalContribution")
	var carry = player.carried_items
	take_seed(wing,"loot_000007")
	await aim_at(player,kitchen)
	await key(KEY_E,true)
	await key(KEY_F,true)
	var panel = kitchen.panel
	if not check(panel.is_open() and panel.lane_rows.size()==2 and player.active_contribution_interface==kitchen and not paused,"F opens two rows with one non-pausing input owner"):
		shell.free()
		finish()
		return
	await key(KEY_E,true,true)
	await key(KEY_E,true)
	await key(KEY_F,true,true)
	check(kitchen.request.spent.is_empty(),"preheld E and F echo cannot submit or close opener")
	var click := InputEventMouseButton.new()
	click.button_index=MOUSE_BUTTON_LEFT
	click.pressed=true
	Input.parse_input_event(click)
	await frames(2)
	check(carry.get_item_count()==1 and kitchen.request.spent.is_empty() and player.world_input_blocked,"panel mouse click cannot TAKE, PUT or contribute through it")
	await key(KEY_E,false)
	await key(KEY_E,true)
	await key(KEY_E,true,true)
	check(kitchen.request.credited.Food==5 and kitchen.request.spent.size()==1,"distinct E submits once to Kitchen only")
	await key(KEY_ESCAPE,true)
	check(not panel.is_open() and not shell.menu_open and not paused,"ESC closes Kitchen before menu")
	await key(KEY_ESCAPE,true,true)
	check(not shell.menu_open,"held ESC cannot open menu")
	await key(KEY_ESCAPE,false)
	await key(KEY_ESCAPE,true)
	check(shell.menu_open and paused,"next distinct ESC opens full pause")
	await key(KEY_ESCAPE,false)
	await key(KEY_ESCAPE,true)
	await key(KEY_ESCAPE,false)
	await key(KEY_F,false)
	await key(KEY_E,false)
	take_seed(wing,"loot_000025")
	await aim_at(player,medical)
	await key(KEY_F,true)
	await key(KEY_F,false)
	await key(KEY_E,true)
	check(medical.panel.is_open() and medical.request.credited.Medical==5 and kitchen.request.credited.Food==5 and not panel.is_open(),"Medical independently owns current panel and exact occurrence")
	await key(KEY_ESCAPE,true)
	await key(KEY_ESCAPE,false)
	await key(KEY_E,false)
	take_seed(wing,"loot_000019")
	await aim_at(player,kitchen)
	await key(KEY_F,true)
	await key(KEY_F,false)
	check(panel.preview_state.lane=="Hydration" and panel.lane_rows.Food.states.count("projected")==0,"selected Hydration previews only second row")
	await key(KEY_E,true)
	await key(KEY_E,false)
	for id: String in ["loot_000006","loot_000007","loot_000008","loot_000009","loot_000012"]:
		take_seed(wing,id)
		await key(KEY_E,true)
		await key(KEY_E,false)
	take_seed(wing,"loot_000010")
	check(panel.preview_state.applied==1 and panel.preview_state.wasted==2 and panel.lane_rows.size()==2,"whole-item cap/waste preview with both lanes")
	check_layout(panel)
	await capture("01-kitchen-waste-1920")
	DisplayServer.window_set_size(Vector2i(1280,720))
	await frames(5)
	check_layout(panel)
	await capture("02-kitchen-waste-1280")
	await key(KEY_E,true)
	await key(KEY_E,false)
	take_seed(wing,"loot_000011")
	var count: int = carry.get_item_count()
	await key(KEY_E,true)
	await key(KEY_E,false)
	check(carry.get_item_count()==count and panel.is_open() and panel.status_label.text=="Food requirement already met","full Food rejects while Hydration remains open")
	await capture("03-kitchen-full-food-1280")
	var book: ItemInstance = wing.get_node("DevelopmentSetup/SeedItems/Book/WorldItem").get_item_instance()
	check(wing.get_node("DevelopmentSetup/SeedItems/Book/WorldItem").pickup_into(carry),"TAKE wrong-lane item")
	carry.select_index(carry.get_slots().find(book))
	check(panel.invalid_highlight and panel.status_label.text=="Selected item not eligible for Kitchen","wrong Utility has red rejection without gain")
	await capture("04-kitchen-ineligible-1280")
	await key(KEY_1,true)
	await key(KEY_1,false)
	check(carry.get_selected_index()==0,"number selection routed to current panel")
	var wheel := InputEventMouseButton.new()
	wheel.button_index=MOUSE_BUTTON_WHEEL_DOWN
	wheel.pressed=true
	Input.parse_input_event(wheel)
	await frames(2)
	check(carry.get_selected_index()!=0,"wheel selection routed to current panel")
	wing.run_schedule.advance(150.0)
	await frames(2)
	check(panel.is_open() and player.active_contribution_interface==kitchen and not medical.is_active(),"Medical expiry cannot hijack or close the active Kitchen panel")
	wing.run_schedule.advance(300.0)
	await frames(3)
	check(not panel.is_open() and not kitchen.is_active() and not player.world_input_blocked,"deadline closes Kitchen and clears its input owner")
	await key(KEY_E,true,true)
	await key(KEY_E,false)
	check(kitchen.panel.request==null,"expired panel cannot defer submission")
	wing.run_schedule.advance(1800.0)
	await frames(5)
	check(paused and shell.report_view.visible and shell.report_view.body.text.contains("Food 30/30") and shell.report_view.body.text.contains("Hydration 3/24"),"expanded report shows captured old-day supplied/required facts")
	check_report_layout(shell.report_view)
	await capture("05-meal-report-1280")
	DisplayServer.window_set_size(Vector2i(1920,1080))
	await frames(5)
	check_report_layout(shell.report_view)
	await capture("06-meal-report-1920")
	print("M3_RENDERED_TIMING ",wing.run_schedule.transition_metrics)
	var report: Dictionary = wing.run_schedule.report.duplicate(true)
	check(shell.save_and_exit() and shell.continue_run() and shell.wing.run_schedule.report==report and paused,"rendered report survives actual same-path Continue")
	shell.wing.set_process(false)
	shell.wing.get_node("Player").set_physics_process(false)
	await frames(3)
	shell.free()
	finish()

func finish() -> void:
	paused=false
	check(_pending_helpers==0,"all rendered helpers completed")
	print("M3_RENDERED_COMPLETE checks=",checks," failures=",failures)
	quit(1 if failures else 0)
